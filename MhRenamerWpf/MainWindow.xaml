<Window x:Class="MhRenamerWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MhRenamerWpf.Models"
        Title="MhRenamer WPF"
        Icon="icon.ico"
        Width="1500"
        Height="720"
        MinWidth="1050"
        MinHeight="520"
        Background="#202020"
        Foreground="#F0F0F0"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#2D2D2D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#4A4A4A" />
        <SolidColorBrush x:Key="TextBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0E639C" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0E639C" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <EventSetter Event="Expanded" Handler="FolderTreeItem_Expanded" />
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Black" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#181818" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Black" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#303030" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#252525" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#15384D" />
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="#2D8CC4" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#0E639C" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type models:FolderTreeItem}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="230" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6">
            <TreeView x:Name="FolderTreeView"
                      ItemsSource="{Binding RootFolders}"
                      SelectedItemChanged="FolderTreeView_SelectedItemChanged" />
        </Border>

        <Border Grid.Row="0"
                Grid.Column="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ListView x:Name="FileListView"
                      ItemsSource="{Binding FileItems}"
                      SelectionMode="Extended"
                      SelectionChanged="FileListView_SelectionChanged">
                <ListView.View>
                    <GridView AllowsColumnReorder="True">
                        <GridViewColumn Header="名前"
                                        Width="480"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="変更後ファイル名"
                                        Width="220"
                                        DisplayMemberBinding="{Binding PreviewName}" />
                        <GridViewColumn Header="サイズ"
                                        Width="90"
                                        DisplayMemberBinding="{Binding Size}" />
                        <GridViewColumn Header="ファイルの種類"
                                        Width="130"
                                        DisplayMemberBinding="{Binding FileType}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Grid.Row="0"
                Grid.Column="4"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="全選択"
                        Click="SelectAllButton_Click" />

                <TextBlock Grid.Row="2"
                           Margin="0,0,0,8"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="リネーム設定" />

                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="開始番号" />
                    <TextBox x:Name="StartNumberTextBox"
                             Grid.Column="1"
                             VerticalContentAlignment="Center"
                             TextChanged="RenameSettingTextBox_TextChanged" />
                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                        <Button Padding="0"
                                Content="▲"
                                Click="StartNumberUpButton_Click" />
                        <Button Padding="0"
                                Content="▼"
                                Click="StartNumberDownButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="桁数" />
                    <TextBox x:Name="DigitsTextBox"
                             Grid.Column="1"
                             VerticalContentAlignment="Center"
                             TextChanged="RenameSettingTextBox_TextChanged" />
                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                        <Button Padding="0"
                                Content="▲"
                                Click="DigitsUpButton_Click" />
                        <Button Padding="0"
                                Content="▼"
                                Click="DigitsDownButton_Click" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="DefaultAllSelectCheckBox"
                          Grid.Row="6"
                          Margin="0,0,0,12"
                          Content="デフォルトで全選択" />

                <Button Grid.Row="7"
                        Height="50"
                        Background="#5A2020"
                        BorderBrush="#A85050"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Content="リネーム"
                        Click="RenameButton_Click" />
            </Grid>
        </Border>

        <TextBlock x:Name="CurrentDirectoryTextBlock"
                   Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="5"
                   Margin="2,8,2,0"
                   Foreground="#BBBBBB"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
